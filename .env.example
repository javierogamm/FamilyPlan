# Solo servidor (nunca con prefijo NEXT_PUBLIC_). Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Notificaciones push (generar con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Secreto para el endpoint /api/cron/notify (cualquier cadena larga y aleatoria)
CRON_SECRET=
# Zona horaria de la familia (por defecto Europe/Madrid)
APP_TZ=Europe/Madrid
